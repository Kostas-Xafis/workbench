{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Workbench",
	"version": "../package.json",
	"identifier": "io.github.kostas-xafis.workbench",
	"build": {
		"frontendDist": "fallback"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [],
		"security": {
			"csp": null,
			"capabilities": []
		}
	},
	"bundle": {
		"active": true,
		"targets": ["deb", "appimage"],
