{
	"name": "workbench",
	"version": "0.2.2",
	"private": true,
	"type": "module",
	"bin": { "wb": "./wb.ts" },
	"scripts": {
		"serve": "bun server.ts",
		"typecheck": "bunx tsc --noEmit",
		"app:dev": "tauri dev",
		"app:build": "tauri build",
		"app:build:release": "tauri build --config src-tauri/tauri.release.conf.json",
		"nightly": "bun scripts/nightly.ts",
		"release": "bun scripts/release.ts",
		"build:server": "bun build --compile --minify --bytecode --sourcemap server.ts --outfile src-tauri/binaries/workbench-server-$(rustc --print host-tuple)"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.4",
		"@types/bun": "latest"
	}
}
