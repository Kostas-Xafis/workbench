{
	"name": "workbench",
	"version": "0.3.1",
	"private": true,
	"type": "module",
	"bin": { "wb": "./src/wb.ts" },
	"scripts": {
		"serve": "bun src/server.ts",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test",
		"app:dev": "tauri dev",
		"app:build": "tauri build",
		"app:build:release": "tauri build --config src-tauri/tauri.release.conf.json",
		"nightly": "bun scripts/nightly.ts",
		"release": "bun scripts/release.ts",
		"build:server": "bun build --compile --minify --bytecode --sourcemap src/server.ts --outfile src-tauri/binaries/workbench-server-$(rustc --print host-tuple)"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.4",
		"@types/bun": "latest"
	}
}
